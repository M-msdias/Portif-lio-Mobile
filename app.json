        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.marceladias.portfolio"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8236ec9-cb6f-4ae2-a729-a12f6ce2cf17"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
